<?xml version="1.0" encoding="utf-8"?>
<!-- One subtype, English, because the projector is typed at rarely and only in one
     language. Android needs this file to list the keyboard at all. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android">
    <subtype
        android:label="@string/keyboard_subtype"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard" />
</input-method>
